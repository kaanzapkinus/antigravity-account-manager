<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.homelab.agyauth</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>agyauth.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>~/.antigravity-profiles</string>

  <!--
    TAILNET_IP verilmezse sunucu yalnız 127.0.0.1 dinler.
    Ağdan erişim istiyorsanız kendi tailnet adresinizi yazın ve
    tailnet ACL'inizi sıkılaştırın.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>~/homelab/agyauth.log</string>
  <key>StandardErrorPath</key>
  <string>~/homelab/agyauth.log</string>
</dict>
</plist>